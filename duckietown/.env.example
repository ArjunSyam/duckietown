# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and takes priority over .env.

# Supabase project (Settings → API)
SUPABASE_URL=
SUPABASE_KEY=

# OpenRouter (https://openrouter.ai/keys) — powers AI chat (with tool
# calling), image captioning, file-profile enrichment at ingest time, and
# organise intent-parsing/judging in the Python sidecar.
OPENROUTER_API_KEY=

# Model overrides — each defaults to anthropic/claude-haiku-5.5 if unset.
CHAT_MODEL=
INTENT_MODEL=
CAPTION_MODEL=
ENRICH_MODEL=
# Deprecated alias for CHAT_MODEL, kept for back-compat — set CHAT_MODEL
# directly instead.
OPENROUTER_MODEL=

# Jina AI (https://jina.ai/embeddings) — powers the CLIP v2 embeddings used
# for semantic search and ingestion in the Python sidecar.
JINA_API_KEY=
