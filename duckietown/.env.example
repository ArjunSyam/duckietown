# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and takes priority over .env.

# Supabase project (Settings → API)
SUPABASE_URL=
SUPABASE_KEY=

# OpenRouter (https://openrouter.ai/keys) — powers AI chat, image captioning,
# and organise-intent parsing in the Python sidecar.
OPENROUTER_API_KEY=
# Optional — defaults to google/gemma-3-27b-it if unset. Only used for chat
# (search.py); image captioning and organise-intent parsing use CAPTION_MODEL
# in sidecar/ingest.py, which is hardcoded, not env-driven.
OPENROUTER_MODEL=

# Jina AI (https://jina.ai/embeddings) — powers the CLIP v2 embeddings used
# for semantic search and ingestion in the Python sidecar.
JINA_API_KEY=
